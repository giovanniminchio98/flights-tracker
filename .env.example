# --- Google OAuth (Google Cloud Console -> APIs & Services -> Credentials) ---
# OAuth client type: "Web application". Add http://localhost:3000/api/auth/callback/google
# (and your production URL equivalent) to "Authorized redirect URIs".
# Enable the "Google Calendar API" and "Google Sheets API" on the project.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# NextAuth
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# --- Google Sheet storage (optional) ---
# Leave empty on first run: the app creates a "Flight Tracker" spreadsheet
# automatically and persists the ID to data/app-config.json (local/dev) or
# logs it so you can copy it here for serverless deploys (Vercel etc, where
# the filesystem is not writable/persistent between invocations).
GOOGLE_SHEET_ID=

# Refresh token used by the unattended /api/cron/sync endpoint (no browser
# session available). Populated automatically into data/app-config.json the
# first time you sign in locally; for serverless deploys copy the value it
# prints into this env var.
GOOGLE_REFRESH_TOKEN=

# --- iCloud CalDAV ---
# Apple ID email address.
ICLOUD_APPLE_ID=
# App-specific password generated at appleid.apple.com
# (Sign-In and Security -> App-Specific Passwords). NEVER your real Apple ID password.
ICLOUD_APP_PASSWORD=

# --- Scheduled sync (optional, e.g. Vercel Cron) ---
# Shared secret required as ?secret=... or Authorization: Bearer <secret> on
# GET /api/cron/sync. Generate with: openssl rand -hex 24
CRON_SECRET=
